# 커뮤니티 전용 환경변수 — 서버의 /opt/planmate-community/.env 로 복사해 값을 채운다.
#
# 이 파일이 따로 있는 이유: 지금까지 커뮤니티는 /opt/planmate-v2/.env 를 통째로 가져다
# 썼다. Backend-v2 의 시크릿이 전부 커뮤니티 컨테이너 환경에 들어간다는 뜻이고, 실제로
# 그 파일의 MINIO_PUBLIC_URL 이 새어들어와 사고가 난 적도 있다. 커뮤니티만의 값은
# 여기로 뺀다.
#
# 넘기는 법 (compose 헤더 참고):
#   docker compose --env-file /opt/planmate-v2/.env \
#                  --env-file /opt/planmate-community/.env \
#                  -f docker-compose.community.yml up -d

# ── DB 계정 ──────────────────────────────────────────────────────────────────
# sql/community-db-account.sql 로 만든 전용 계정. planmate2 에는 CONNECT 가 안 된다.
# 아래 비밀번호는 그 스크립트에 -v community_password 로 넘긴 값과 같아야 한다.
COMMUNITY_DB_USER=community_app
COMMUNITY_DB_PASSWORD=

# ── 앞으로 여기로 옮길 값 ────────────────────────────────────────────────────
# JWT 는 MAIN_BACKEND_JWKS 로 공개키만 받는다. 대칭키(JWT_SECRET)는 주입하지 않는다 —
# 2026-08-22 에 HS 검증 경로를 코드에서 제거했으므로 넣어도 아무 효과가 없다.
